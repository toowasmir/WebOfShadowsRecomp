{
    "lang": "tr",
    "theme": "symbiote",
    "resolution": "1600x900",
    "window_width": 1600,
    "window_height": 900,
    "fullscreen": false,
    "vsync": false,
    "vrr_tearing": false,
    "letterbox": true,
    "dither": true,
    "present_effect": "fsr",
    "fsr_quality_mode": "quality",
    "fsr_sharpness": 0.2,
    "cas_sharpness": 0.5,
    "fsr_max_passes": 2,
    "frame_generation": false,
    "fg_multiplier": 2,
    "frame_limit": 60,
    "resolution_scale": 1,
    "vram_profile": "4gb",
    "anisotropic_override": 0,
    "occlusion_query_enable": false,
    "fuzzy_alpha_epsilon": true,
    "d3d12_render_target_path": "auto",
    "mnk_mouse": true,
    "mnk_sensitivity": 1.0,
    "keybind_a": "Space",
    "keybind_b": "C",
    "keybind_x": "LMB",
    "keybind_y": "F",
    "keybind_left_shoulder": "Q",
    "keybind_right_shoulder": "E",
    "keybind_left_trigger": "RMB",
    "keybind_right_trigger": "LShift",
    "keybind_start": "Tab",
    "keybind_back": "Escape",
    "keybind_lstick_up": "W",
    "keybind_lstick_down": "S",
    "keybind_lstick_left": "A",
    "keybind_lstick_right": "D",
    "keybind_lstick_press": "LAlt",
    "keybind_rstick_press": "V"
}